_fkube__doctor() {
    local cmd
    local rc=0

    printf 'fkube %s\n\n' "$(_fkube__version)"
    for cmd in bash kubectl fzf awk mktemp; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '  [OK]   %s -> %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '  [MISS] %s\n' "$cmd"
            rc=1
        fi
    done

    printf '\nOptional:\n'
    for cmd in bat less wl-copy xclip xsel pbcopy; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '  [OK]   %s -> %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '  [----] %s\n' "$cmd"
        fi
    done

    if command -v kubectl >/dev/null 2>&1; then
        printf '\nKubectl client:\n'
        _fkube__kubectl version --client=true --output=yaml 2>/dev/null | awk '
            /gitVersion:/ { print "  " $0; found=1; exit }
            END { if (!found) print "  unable to query kubectl client version" }
        '

        printf 'Current context: %s\n' "$(_fkube__current_context)"
        printf 'Current namespace: %s\n' "$(_fkube__current_namespace)"
    fi

    return "$rc"
}

# ----------------------------------------------------------------------------
# Public dispatcher
# -----------------------------------------------------------------------------

_fkube__dispatch() {
    local namespace=''
    local all_namespaces=0
    local arg

    while (($#)); do
        arg=$1
        case $arg in
            -n|--namespace)
                if (($# < 2)); then
                    printf 'fkube: %s requires a namespace.\n' "$arg" >&2
                    return 2
                fi
                namespace=$2
                shift 2
                ;;
            -A|--all-namespaces)
                all_namespaces=1
                shift
                ;;
            ctx|context|contexts)
                shift
                # A context picker is not namespaced; an -n value encountered
                # before it is rejected to avoid silently ignoring user input.
                if [[ -n $namespace || $all_namespaces -eq 1 ]]; then
                    printf 'fkube: namespace flags are not applicable to the context picker.\n' >&2
                    return 2
                fi
                _fkube__contexts "$@"
                return $?
                ;;
            ns|namespace|namespaces)
                shift
                if [[ -n $namespace || $all_namespaces -eq 1 ]]; then
                    printf 'fkube: namespace flags are not applicable to the namespace gate.\n' >&2
                    return 2
                fi
                _fkube__namespaces "$@"
                return $?
                ;;
            resource|resources|type|types)
                shift
                local resource_namespace=$namespace
                local -a resource_query=()

                while (($#)); do
                    arg=$1
                    case $arg in
                        -n|--namespace)
                            if (($# < 2)); then
                                printf 'fkube: %s requires a namespace.\n' "$arg" >&2
                                return 2
                            fi
                            resource_namespace=$2
                            shift 2
                            ;;
                        -A|--all-namespaces)
                            shift
                            ;;
                        --)
                            shift
                            resource_query+=("$@")
                            break
                            ;;
                        *)
                            resource_query+=("$arg")
                            shift
                            ;;
                    esac
                done

                local query=''
                ((${#resource_query[@]})) && query=${resource_query[*]}
                if [[ -n $resource_namespace ]]; then
                    _fkube__resource_types "$resource_namespace" "$query"
                else
                    _fkube__resource_types '' "$query"
                fi
                return $?
                ;;
            doctor|--doctor)
                shift
                (($# == 0)) || {
                    printf 'fkube: doctor does not accept additional arguments.\n' >&2
                    return 2
                }
                _fkube__doctor
                return $?
                ;;
            help|-h|--help)
                _fkube__help
                return 0
                ;;
            version|--version)
                printf 'fkube %s\n' "$(_fkube__version)"
                return 0
                ;;
            '')
                _fkube__resource_types
                return $?
                ;;
            *)
                # Everything after the resource is parsed by the resource
                # picker, preserving arbitrary fzf query words.
                if [[ -n $namespace ]]; then
                    if ((all_namespaces)); then
                        _fkube__resource_picker "$arg" -n "$namespace" -A "${@:2}"
                    else
                        _fkube__resource_picker "$arg" -n "$namespace" "${@:2}"
                    fi
                elif ((all_namespaces)); then
                    _fkube__resource_picker "$arg" -A "${@:2}"
                else
                    _fkube__resource_picker "$@"
                fi
                return $?
                ;;
        esac
    done

    if [[ -n $namespace ]]; then
        if ((all_namespaces)); then
            _fkube__resource_types "$namespace"
        else
            _fkube__resource_types "$namespace"
        fi
    else
        _fkube__resource_types
    fi
}

fkube() {
    local assume_yes=0
    local confirm_mode='inherit'
    local -a filtered=()
    local arg
    local parse_global=1

    # Extract global safety switches anywhere before `--`. This lets users use
    # either `fkube --yes pods` or `fkube pods --yes` without changing query
    # semantics. Everything else is passed through unchanged.
    while (($#)); do
        arg=$1
        if ((parse_global)); then
            case $arg in
                -y|--yes|--assume-yes)
                    assume_yes=1
                    shift
                    continue
                    ;;
                --no-confirm)
                    confirm_mode='off'
                    shift
                    continue
                    ;;
                --confirm)
                    confirm_mode='on'
                    shift
                    continue
                    ;;
                --)
                    parse_global=0
                    filtered+=("$arg")
                    shift
                    continue
                    ;;
            esac
        fi
        filtered+=("$arg")
        shift
    done

    local had_assume=0 old_assume=''
    local had_confirm=0 old_confirm=''
    if [[ ${FKUBE__ASSUME_YES+x} ]]; then
        had_assume=1
        old_assume=$FKUBE__ASSUME_YES
    fi
    if [[ ${FKUBE__CONFIRM_MUTATIONS+x} ]]; then
        had_confirm=1
        old_confirm=$FKUBE__CONFIRM_MUTATIONS
    fi

    if ((assume_yes)); then
        export FKUBE__ASSUME_YES=1
    fi

    case $confirm_mode in
        off) export FKUBE__CONFIRM_MUTATIONS=0 ;;
        on) export FKUBE__CONFIRM_MUTATIONS=1 ;;
    esac

    _fkube__dispatch "${filtered[@]}"
    local rc=$?

    # Restore the caller's environment because this script is sourceable.
    if ((had_assume)); then
        export FKUBE__ASSUME_YES=$old_assume
    else
        unset FKUBE__ASSUME_YES
    fi
    if ((had_confirm)); then
        export FKUBE__CONFIRM_MUTATIONS=$old_confirm
    else
        unset FKUBE__CONFIRM_MUTATIONS
    fi

    return "$rc"
}

