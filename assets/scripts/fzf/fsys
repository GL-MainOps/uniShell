}

_fsys__boots_list() {
    local scope=${1:-system}
    _fsys__valid_scope "$scope" || return 2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    journalctl "${scope_args[@]}" --list-boots --no-pager 2>/dev/null
