        systemctl "${scope_args[@]}" --failed --no-legend --no-pager | wc -l
        printf '\n----- active jobs -----\n'
        systemctl "${scope_args[@]}" list-jobs --no-pager 2>&1 || true
        printf '\n----- failed units -----\n'
        systemctl "${scope_args[@]}" --failed --no-pager 2>&1 || true
    } | _fsys__render text
    _fsys__pause
}

_fsys__linger_status() {
    command -v loginctl >/dev/null 2>&1 || {
        printf 'fsys: loginctl is required for linger management.\n' >&2
        return 127
    }

    local user=${USER:-$(id -un)}
    loginctl show-user "$user" -p Linger --value 2>&1
}

_fsys__linger() {
    command -v loginctl >/dev/null 2>&1 || {
        printf 'fsys: loginctl is required for linger management.\n' >&2
        return 127
    }

    local user=${USER:-$(id -un)}
    local state
    state=$(loginctl show-user "$user" -p Linger --value 2>/dev/null) || {
        printf 'fsys: cannot determine linger state for %s.\n' "$user" >&2
        return 1
    }

    printf 'User:   %s\nLinger: %s\n\n' "$user" "$state"
    printf '1) Enable linger\n2) Disable linger\n3) Show status\nq) Cancel\n\nChoice: ' >&2

    local choice
    IFS= read -r choice </dev/tty || return 1
    case $choice in
        1)
            _fsys__confirm system enable-linger "$user" || {
                printf 'fsys: linger enable cancelled.\n' >&2
                return 0
            }
            if ((EUID == 0)); then
                loginctl enable-linger "$user"
            else
                sudo -v || return 1
                sudo loginctl enable-linger "$user"
            fi
            ;;
        2)
            _fsys__confirm system disable-linger "$user" || {
                printf 'fsys: linger disable cancelled.\n' >&2
                return 0
            }
            if ((EUID == 0)); then
                loginctl disable-linger "$user"
            else
                sudo -v || return 1
                sudo loginctl disable-linger "$user"
            fi
            ;;
        3)
            _fsys__linger_status
            ;;
        *)
            return 0
            ;;
    esac
}

