_fsys__scope_menu() {
    local scope=${1:-system}
    _fsys__valid_scope "$scope" || return 2
    local selected

    selected=$(
        _fsys__scope_menu_list "$scope" |
            fzf \
                --with-shell='bash -c' \
                --exact \
                --no-multi \
                --delimiter=$'\t' \
                --with-nth=2 \
                --accept-nth='{1}' \
                --prompt="systemd $scope ❯❯❯ " \
                --header="$(_fsys__menu_header)" \
                --preview="_fsys__menu_preview ${scope}-{1}" \
                --preview-window='right:55%:hidden:wrap' \
                --bind="ctrl-r:reload(_fsys__scope_menu_list '$scope')"
    ) || return 0

    case $selected in
        overview) _fsys__overview "$scope" ;;
        failed) _fsys__failed "$scope" ;;
        services) _fsys__services "$scope" ;;
        timers) _fsys__timers "$scope" ;;
        units) _fsys__units "$scope" ;;
        unitfiles) _fsys__unit_files "$scope" ;;
        logs) _fsys__logs "$scope" ;;
        boots) _fsys__boots "$scope" ;;
    esac
}

