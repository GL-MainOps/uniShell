# -----------------------------------------------------------------------------
# Previews
# -----------------------------------------------------------------------------

_fsys__service_preview() {
    local scope=$1 unit=$2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    _fsys__unit_args_valid "$unit" || return 2
    systemctl "${scope_args[@]}" status --no-pager --full "$unit" 2>&1 |
        _fsys__preview_render text
}

_fsys__timer_preview() {
    local scope=$1 timer=$2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    _fsys__unit_args_valid "$timer" || return 2
    {
        systemctl "${scope_args[@]}" status --no-pager --full "$timer" 2>&1
        printf '\n--- timer calendar ---\n'
        systemctl "${scope_args[@]}" list-timers --all --no-pager --full --plain 2>&1 |
            grep -F -- "$timer" || true
    } | _fsys__preview_render text
}

_fsys__unit_preview() {
    local scope=$1 unit=$2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    _fsys__unit_args_valid "$unit" || return 2
    systemctl "${scope_args[@]}" status --no-pager --full "$unit" 2>&1 |
        _fsys__preview_render text
}

_fsys__logs_preview() {
    local scope=$1 unit=$2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    _fsys__unit_args_valid "$unit" || return 2
    journalctl "${scope_args[@]}" --no-pager --full -n "$FSYS_PREVIEW_LOG_LINES" -u "$unit" 2>&1 |
        _fsys__preview_render text
}

_fsys__failed_preview() {
    local scope=$1 unit=$2
    _fsys__service_preview "$scope" "$unit"
}

# -----------------------------------------------------------------------------
# Dedicated interactive actions
# -----------------------------------------------------------------------------

_fsys__edit_selected() {
    local scope=$1
    local file=$2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    [[ -r $file ]] || {
        printf 'fsys: selection file is not readable: %s\n' "$file" >&2
        return 2
    }

    local -a units=()
    mapfile -t units < <(_fsys__read_units "$file")

    ((${#units[@]} == 1)) || {
        printf 'fsys: edit requires exactly one selected unit.\n' >&2
        _fsys__pause
        return 1
    }

    local unit=${units[0]}
    _fsys__unit_args_valid "$unit" || return 2

    _fsys__confirm "$scope" edit "$unit" || {
        printf 'fsys: edit cancelled.\n' >&2
        return 0
    }

    if [[ $scope == user ]]; then
        systemctl --user edit "$unit" </dev/tty >/dev/tty 2>/dev/tty
        return $?
    fi

    command -v sudo >/dev/null 2>&1 || {
        ((EUID == 0)) || {
            printf 'fsys: sudo is required for system-manager edits.\n' >&2
            return 127
        }
    }

    if ((EUID != 0)); then
        sudo -v || {
            printf 'fsys: sudo authentication failed; edit not started.\n' >&2
            return 1
        }
    fi

    _fsys__sudo_systemctl edit "$unit" </dev/tty >/dev/tty 2>/dev/tty
}

_fsys__cat_selected() {
    local scope=$1
    local kind=$2
    local file=$3
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    local -a units=()
    mapfile -t units < <(_fsys__read_units "$file") || return
    ((${#units[@]})) || return 0
    _fsys__unit_args_valid "${units[@]}" || return 2

    systemctl "${scope_args[@]}" --no-pager --full cat "${units[@]}" 2>&1 |
        _fsys__render text
    _fsys__pause
}

_fsys__show_properties() {
    local scope=$1
    local file=$2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    local -a units=()
    mapfile -t units < <(_fsys__read_units "$file") || return
    ((${#units[@]})) || return 0
    _fsys__unit_args_valid "${units[@]}" || return 2

    systemctl "${scope_args[@]}" show \
        --no-pager \
        --property=Id,Names,Description,LoadState,ActiveState,SubState,FragmentPath,UnitFileState,UnitFilePreset,User,Group,MainPID,ExecMainStartTimestamp,Restart \
        "${units[@]}" 2>&1 |
        _fsys__render text
    _fsys__pause
}

_fsys__dependencies_selected() {
    local scope=$1
    local file=$2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    local -a units=()
    mapfile -t units < <(_fsys__read_units "$file") || return
    ((${#units[@]})) || return 0
    _fsys__unit_args_valid "${units[@]}" || return 2

    local unit
    for unit in "${units[@]}"; do
        printf '\n===== %s =====\n' "$unit"
        systemctl "${scope_args[@]}" list-dependencies --all --no-pager "$unit" 2>&1
    done | _fsys__render text
    _fsys__pause
}

# -----------------------------------------------------------------------------
# Generic action dispatcher
# -----------------------------------------------------------------------------

_fsys__journal_selected() {
    local scope=$1
    local action=$2
    local file=$3
    local boot=${4-}
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    local -a units=() journal_opts=()
    mapfile -t units < <(_fsys__read_units "$file") || return
    ((${#units[@]})) || return 0
    _fsys__unit_args_valid "${units[@]}" || return 2

    local unit
    for unit in "${units[@]}"; do
        journal_opts+=( -u "$unit" )
    done

    case $action in
        logs)
            journalctl "${scope_args[@]}" --no-pager --full -n "$FSYS_LOG_LINES" "${journal_opts[@]}" |
                _fsys__render text
            _fsys__pause
            ;;
        previous)
            journalctl "${scope_args[@]}" --no-pager --full -b -1 "${journal_opts[@]}" |
                _fsys__render text
            _fsys__pause
            ;;
        errors)
            journalctl "${scope_args[@]}" --no-pager --full -n "$FSYS_LOG_LINES" -p err..emerg "${journal_opts[@]}" |
                _fsys__render text
            _fsys__pause
            ;;
        warnings)
            journalctl "${scope_args[@]}" --no-pager --full -n "$FSYS_LOG_LINES" -p warning..emerg "${journal_opts[@]}" |
                _fsys__render text
            _fsys__pause
            ;;
        follow)
            journalctl "${scope_args[@]}" -f --full -n "$FSYS_LOG_LINES" "${journal_opts[@]}"
            ;;
        *)
            printf 'fsys: unknown journal action: %s\n' "$action" >&2
            return 2
            ;;
    esac
}

_fsys__action() {
    local action=$1
    local scope=$2
    local kind=$3
    local file=$4
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    _fsys__valid_scope "$scope" || return 2
    [[ -r $file ]] || {
        printf 'fsys: selection file is not readable: %s\n' "$file" >&2
        return 2
    }

    local -a units=() targets=()
    local line unit target _rest

    if [[ $kind == timer ]]; then
        while IFS= read -r line; do
            [[ -n $line ]] || continue
            IFS=$'\t' read -r unit target _rest <<< "$line"
            [[ -n $unit ]] || continue
            units+=("$unit")
            targets+=("$target")
        done < "$file"
    else
        while IFS= read -r line; do
            [[ -n $line ]] || continue
            IFS=$'\t' read -r unit _rest <<< "$line"
            [[ -n $unit ]] || continue
            units+=("$unit")
        done < "$file"
    fi

    ((${#units[@]})) || return 0
    _fsys__unit_args_valid "${units[@]}" || {
        printf 'fsys: refusing invalid unit argument(s).\n' >&2
        return 2
    }

    case $action in
        status)
            systemctl "${scope_args[@]}" status --no-pager --full "${units[@]}" 2>&1 |
                _fsys__render text
            _fsys__pause
            ;;

        properties)
            _fsys__show_properties "$scope" "$file"
            ;;

        dependencies)
            _fsys__dependencies_selected "$scope" "$file"
            ;;

        start|stop|restart|reload|enable|disable|mask|unmask|reset-failed)
            _fsys__systemctl_mutate "$scope" "$action" "${units[@]}"
            ;;

        edit)
            _fsys__edit_selected "$scope" "$file"
            ;;

        cat)
            _fsys__cat_selected "$scope" "$kind" "$file"
            ;;

        logs|follow|previous|errors|warnings)
            _fsys__journal_selected "$scope" "$action" "$file"
            ;;

        copy)
            _fsys__copy_selected "$file"
            ;;

        daemon-reload)
            _fsys__daemon_reload "$scope"
            ;;

        target-logs)
            local -a journal_opts=()
            for target in "${targets[@]}"; do
                [[ -n $target ]] || continue
                _fsys__unit_args_valid "$target" || return 2
                journal_opts+=( -u "$target" )
            done
            ((${#journal_opts[@]})) || return 0
            journalctl "${scope_args[@]}" --no-pager --full -n "$FSYS_LOG_LINES" "${journal_opts[@]}" |
                _fsys__render text
            _fsys__pause
            ;;

        target-follow)
            ((${#targets[@]} == 1)) || {
                printf 'fsys: target follow requires exactly one selected timer.\n' >&2
                _fsys__pause
                return 1
            }
            _fsys__unit_args_valid "${targets[0]}" || return 2
            journalctl "${scope_args[@]}" -f --full -n "$FSYS_LOG_LINES" -u "${targets[0]}"
            ;;

        trigger)
            local -a target_units=()
            for target in "${targets[@]}"; do
                [[ -n $target ]] || continue
                _fsys__unit_args_valid "$target" || return 2
                target_units+=("$target")
            done
            ((${#target_units[@]})) || return 0
            _fsys__systemctl_mutate_as "$scope" start trigger "${target_units[@]}"
            ;;

        *)
            printf 'fsys: unknown action: %s\n' "$action" >&2
            return 2
            ;;
    esac
}

