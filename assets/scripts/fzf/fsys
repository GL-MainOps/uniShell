#!/usr/bin/env bash

# fsys - fzf-driven systemd workflows for Bash
#
# Purpose:
#   A compact, keyboard-driven interface to the system and user systemd
#   managers. It is intentionally implemented as a Bash function so it can be
#   sourced from .bashrc, while also supporting direct execution as a script.
#
# Design goals:
#   - Preserve the original workflows and key bindings.
#   - Exact fzf matching by default; previews start hidden.
#   - System and user manager operations are explicit and never mixed.
#   - Mutating actions require confirmation by default, before sudo is invoked.
#   - Destructive/high-impact actions require typing YES; ordinary mutations
#     require y/yes. --yes is an explicit per-invocation bypass.
#   - Never interpolate a selected unit into a command more than necessary;
#     selected values are passed as individual shell arguments.
#   - Keep interactive editors attached to /dev/tty.
#   - Keep sudo's useful interactive environment, including EDITOR/VISUAL.
#   - Be useful even without bat, clipboard tools, or a graphical session.
#
# Requirements:
#   bash, systemctl, journalctl, fzf
#
# Optional:
#   bat       colored output
#   wl-copy   Wayland clipboard
#   xclip     X11 clipboard
#   xsel      X11 clipboard
#   pbcopy    macOS clipboard (useful when the script is shared)
#
# Examples:
#   source /path/to/fsys
#   fsys
#   fsys services
#   fsys services ssh
#   fsys user services
#   fsys -u timers
#   fsys --yes service
#   ./fsys logs
#
# vim: set ft=bash:

# Do not enable `set -e`, `set -u`, or shell options globally here: this file is
# designed to be sourced into an interactive shell and must not alter the
# caller's shell semantics.

# -----------------------------------------------------------------------------
# Version / configuration
# -----------------------------------------------------------------------------

FSYS_VERSION='2.0.0'
FSYS_LOG_LINES="${FSYS_LOG_LINES:-200}"
FSYS_PREVIEW_LOG_LINES="${FSYS_PREVIEW_LOG_LINES:-40}"
FSYS_SNAPSHOT_LOG_LINES="${FSYS_SNAPSHOT_LOG_LINES:-500}"
FSYS_SUDO_PRESERVE_ENV="${FSYS_SUDO_PRESERVE_ENV:-EDITOR,VISUAL,MANPAGER,PAGER,PATH,TERM,COLORTERM,TMUX,SSH_AUTH_SOCK,UNISHELL_SESSION_RUNTIME_DIR}"
export FSYS_VERSION FSYS_LOG_LINES FSYS_PREVIEW_LOG_LINES FSYS_SNAPSHOT_LOG_LINES FSYS_SUDO_PRESERVE_ENV
[[ ${FSYS_ASSUME_YES+x} ]] && export FSYS_ASSUME_YES

# -----------------------------------------------------------------------------
# Common helpers
# -----------------------------------------------------------------------------

_fsys__version() {
    printf 'fsys %s\n' "$FSYS_VERSION"
}

_fsys__usage_error() {
    printf 'fsys: %s\n' "$*" >&2
    printf 'Run `fsys --help` for usage.\n' >&2
    return 2
}

_fsys__valid_scope() {
    case ${1-} in
        system|user) return 0 ;;
        *) return 1 ;;
    esac
}

_fsys__require_commands() {
    local missing=()
    local cmd

    for cmd in systemctl journalctl fzf; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done

    if ((${#missing[@]})); then
        printf 'fsys: missing command(s): %s\n' "${missing[*]}" >&2
        return 127
    fi
}

_fsys__pause() {
    # fzf execute actions have a real controlling terminal, but tests and
    # unusual SSH/session setups may not. Never block forever without /dev/tty.
    [[ -r /dev/tty ]] || return 0
    printf '\nPress Enter to return to fzf...' >&2
    IFS= read -r _ </dev/tty
}

_fsys__render() {
    local language=${1:-text}

    if command -v bat >/dev/null 2>&1; then
        if [[ $language == text ]]; then
            bat --style=plain --color=always --paging=never 2>/dev/null
        else
            bat \
                --style=plain \
                --color=always \
                --paging=never \
                --language="$language" \
                2>/dev/null
        fi
    else
        cat
    fi
}

_fsys__preview_render() {
    _fsys__render "${1:-text}"
}

_fsys__clip() {
    local value
    value=$(< /dev/stdin)

    if command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$value" | wl-copy
    elif command -v xclip >/dev/null 2>&1; then
        printf '%s' "$value" | xclip -selection clipboard
    elif command -v xsel >/dev/null 2>&1; then
        printf '%s' "$value" | xsel --clipboard --input
    elif command -v pbcopy >/dev/null 2>&1; then
        printf '%s' "$value" | pbcopy
    else
        printf '%s\n' "$value"
        printf 'fsys: no clipboard command found.\n' >&2
        return 1
    fi
}

_fsys__scope_label() {
    [[ ${1:-system} == user ]] && printf 'user' || printf 'system'
}

_fsys__scope_args() {
    [[ ${1:-system} == user ]] && printf '%s\n' '--user'
}

_fsys__unit_args_valid() {
    local unit

    for unit in "$@"; do
        # Unit names emitted by systemctl do not contain literal tabs/newlines.
        # Reject an option-looking unit as an additional defense in case a
        # caller invokes an exported helper directly rather than through fzf.
        [[ -n $unit ]] || return 1
        [[ $unit != -* ]] || return 1
        [[ $unit != *$'\t'* ]] || return 1
        [[ $unit != *$'\n'* ]] || return 1
    done
}

# -----------------------------------------------------------------------------
# Privilege, confirmation, and systemctl execution
# -----------------------------------------------------------------------------

# Run system-manager systemctl without changing the caller's environment.
# Root shells do not need sudo and should not be forced through it.
_fsys__sudo_systemctl() {
    if ((EUID == 0)); then
        command systemctl "$@"
        return
    fi

    sudo --preserve-env="$FSYS_SUDO_PRESERVE_ENV" systemctl "$@"
}

# Prompt before any mutating operation. The default policy is intentionally
# conservative:
#   y/yes  -> ordinary mutation
#   YES    -> destructive/high-impact mutation
#   --yes  -> explicit per-invocation bypass
_fsys__confirm() {
    local scope=$1
    local operation=$2
    shift 2
    local -a units=("$@")
    local reply level='normal' label
    local count=${#units[@]}
    local max_display=12
    local shown=0

    [[ ${FSYS_ASSUME_YES:-0} == 1 ]] && return 0

    case $operation in
        stop|disable|mask|reset-failed|edit|trigger|daemon-reload|reexec|enable-linger|disable-linger)
            level='high'
            ;;
    esac

    label="$(printf '%s' "$operation" | tr '[:lower:]' '[:upper:]')"

    if [[ $scope == system ]]; then
        printf '\n%s SYSTEM-MANAGER OPERATION\n' 'fsys:' >&2
    else
        printf '\n%s USER-MANAGER OPERATION\n' 'fsys:' >&2
    fi

    printf '  operation : %s\n' "$label" >&2
    if ((${#units[@]})); then
        printf '  units     : %d\n' "$count" >&2
        for unit in "${units[@]}"; do
            printf '    - %s\n' "$unit" >&2
            shown=$((shown + 1))
            if ((shown >= max_display)); then
                if ((count > max_display)); then
                    printf '    - ... (%d more)\n' "$((count - max_display))" >&2
                fi
                break
            fi
        done
    fi

    if [[ $level == high ]]; then
        printf '  This action can change or remove active system state.\n' >&2
        printf '  Type YES to continue: ' >&2
        IFS= read -r reply </dev/tty || return 1
        [[ $reply == YES ]]
    else
        printf '  Continue? [y/N]: ' >&2
        IFS= read -r reply </dev/tty || return 1
        case ${reply,,} in
            y|yes) return 0 ;;
            *) return 1 ;;
        esac
    fi
}

_fsys__systemctl_mutate_as() {
    local scope=${1:-system}
    local action=${2-}
    local confirmation=${3-}
    shift 3 || true
    local -a units=("$@")

    _fsys__valid_scope "$scope" || {
        printf 'fsys: invalid scope: %s\n' "$scope" >&2
        return 2
    }

    [[ -n $action ]] || {
        printf 'fsys: mutation action is empty.\n' >&2
        return 2
    }
    [[ -n $confirmation ]] && : || confirmation=$action

    ((${#units[@]})) || return 0
    _fsys__unit_args_valid "${units[@]}" || {
        printf 'fsys: refusing an invalid unit argument.\n' >&2
        return 2
    }

    _fsys__confirm "$scope" "$confirmation" "${units[@]}" || {
        printf 'fsys: action cancelled.\n' >&2
        return 0
    }

    if [[ $scope == user ]]; then
        command systemctl --user "$action" "${units[@]}"
        return $?
    fi

    command -v sudo >/dev/null 2>&1 || {
        if ((EUID == 0)); then
            command systemctl "$action" "${units[@]}"
            return $?
        fi
        printf 'fsys: sudo is required for system-manager mutations.\n' >&2
        return 127
    }

    # Ask for sudo credentials only after the user has explicitly confirmed.
    if ((EUID != 0)); then
        sudo -v || {
            printf 'fsys: sudo authentication failed; action not executed.\n' >&2
            return 1
        }
    fi

    _fsys__sudo_systemctl "$action" "${units[@]}"
}

_fsys__systemctl_mutate() {
    local scope=${1:-system}
    local action=${2-}
    shift 2 || true
    _fsys__systemctl_mutate_as "$scope" "$action" "$action" "$@"
}

_fsys__daemon_reload() {
    local scope=${1:-system}

    _fsys__valid_scope "$scope" || return 2
    _fsys__confirm "$scope" daemon-reload || {
        printf 'fsys: daemon-reload cancelled.\n' >&2
        return 0
    }

    if [[ $scope == user ]]; then
        systemctl --user daemon-reload
    else
        command -v sudo >/dev/null 2>&1 || {
            ((EUID == 0)) || {
                printf 'fsys: sudo is required for system-manager daemon-reload.\n' >&2
                return 127
            }
        }
        if ((EUID != 0)) && ! sudo -v; then
            printf 'fsys: sudo authentication failed; daemon-reload not executed.\n' >&2
            return 1
        fi
        _fsys__sudo_systemctl daemon-reload
    fi
}

_fsys__reset_failed_all() {
    local scope=${1:-system}
    _fsys__valid_scope "$scope" || return 2

    _fsys__confirm "$scope" reset-failed || {
        printf 'fsys: reset-failed cancelled.\n' >&2
        return 0
    }

    if [[ $scope == user ]]; then
        systemctl --user reset-failed
    else
        command -v sudo >/dev/null 2>&1 || {
            ((EUID == 0)) || {
                printf 'fsys: sudo is required for system-manager reset-failed.\n' >&2
                return 127
            }
        }
        if ((EUID != 0)) && ! sudo -v; then
            printf 'fsys: sudo authentication failed; reset-failed not executed.\n' >&2
            return 1
        fi
        _fsys__sudo_systemctl reset-failed
    fi
}

# -----------------------------------------------------------------------------
# Selection-file helpers
# -----------------------------------------------------------------------------

_fsys__read_units() {
    local file=$1
    [[ -r $file ]] || {
        printf 'fsys: selection file is not readable: %s\n' "$file" >&2
        return 2
    }

    local line unit
    while IFS= read -r line; do
        [[ -n $line ]] || continue
        IFS=$'\t' read -r unit _ <<< "$line"
        [[ -n $unit ]] || continue
        printf '%s\n' "$unit"
    done < "$file"
}

_fsys__read_timer_pairs() {
    local file=$1
    [[ -r $file ]] || {
        printf 'fsys: selection file is not readable: %s\n' "$file" >&2
        return 2
    }

    local line timer target
    while IFS= read -r line; do
        [[ -n $line ]] || continue
        IFS=$'\t' read -r timer target _ <<< "$line"
        [[ -n $timer && -n $target ]] || continue
        printf '%s\t%s\n' "$timer" "$target"
    done < "$file"
}

_fsys__copy_selected() {
    local file=$1
    local separator=${2:-$'\n'}
    local value

    value=$(_fsys__read_units "$file") || return
    [[ -n $value ]] || return 0

    printf '%s%s' "$value" "$separator" | _fsys__clip
}

# -----------------------------------------------------------------------------
# systemd list builders
# -----------------------------------------------------------------------------

_fsys__services_list() {
    local scope=${1:-system}
    _fsys__valid_scope "$scope" || return 2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    systemctl "${scope_args[@]}" \
        list-units \
        --type=service \
        --all \
        --no-legend \
        --no-pager \
        --full \
        --plain 2>/dev/null |
        awk '
            {
                unit = $1
                load = $2
                active = $3
                substate = $4
                if (unit == "") next

                description = ""
                if (NF >= 5) {
                    match($0, /^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]*/)
                    description = substr($0, RSTART + RLENGTH)
                }

                u[++count] = unit
                l[count] = load
                a[count] = active
                s[count] = substate
                d[count] = description

                if (length(unit) > wu) wu = length(unit)
                if (length(load) > wl) wl = length(load)
                if (length(active) > wa) wa = length(active)
                if (length(substate) > ws) ws = length(substate)
            }
            END {
                for (i = 1; i <= count; i++)
                    printf "%s\t%s\t%s\t%s\t%-*s  %-*s  %-*s  %-*s  %s\n", \
                        u[i], l[i], a[i], s[i], \
                        wu, u[i], wl, l[i], wa, a[i], ws, s[i], d[i]
            }
        '
}

_fsys__timers_list() {
    local scope=${1:-system}
    _fsys__valid_scope "$scope" || return 2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    systemctl "${scope_args[@]}" \
        list-timers \
        --all \
        --no-legend \
        --no-pager \
        --full \
        --plain 2>/dev/null |
        awk '
            {
                if (NF < 2) next

                timer = $(NF - 1)
                activates = $NF

                prefix = $0
                sub(/[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]*$/, "", prefix)
                sub(/[[:space:]]+$/, "", prefix)

                t[++count] = timer
                ac[count] = activates
                p[count] = prefix

                if (length(prefix) > wp) wp = length(prefix)
                if (length(timer) > wt) wt = length(timer)
                if (length(activates) > wa) wa = length(activates)
            }
            END {
                for (i = 1; i <= count; i++)
                    printf "%s\t%s\t%-*s  %-*s  %-*s\n", \
                        t[i], ac[i], wp, p[i], wt, t[i], wa, ac[i]
            }
        '
}

