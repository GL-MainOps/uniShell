        system-overview) _fsys__overview system ;;
        system-failed) _fsys__failed system ;;
        system-services) _fsys__services system ;;
        system-timers) _fsys__timers system ;;
        system-units) _fsys__units system ;;
        system-unitfiles) _fsys__unit_files system ;;
        system-logs) _fsys__logs system ;;
        system-boots) _fsys__boots system ;;
