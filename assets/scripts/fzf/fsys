_fsys__unit_files_list() {
    local scope=${1:-system}
    _fsys__valid_scope "$scope" || return 2
    local -a scope_args=()
    [[ $scope == user ]] && scope_args+=(--user)

    systemctl "${scope_args[@]}" \
        list-unit-files \
        --no-legend \
        --no-pager \
        --full \
        --plain 2>/dev/null |
        awk '
            {
                if ($1 == "") next
                u[++count] = $1
                s[count] = $2
                p[count] = $3
                if (length(u[count]) > wu) wu = length(u[count])
                if (length(s[count]) > ws) ws = length(s[count])
                if (length(p[count]) > wp) wp = length(p[count])
            }
            END {
                for (i = 1; i <= count; i++)
                    printf "%s\t%s\t%s\t%-*s  %-*s  %-*s\n", \
