# -----------------------------------------------------------------------------
# Public command
# -----------------------------------------------------------------------------

fsys() {
    local scope=system
    local explicit_scope=false
    local command=''
    local query=''
    local old_assume_yes=${FSYS_ASSUME_YES-}
    local had_assume_yes=false

    if [[ ${FSYS_ASSUME_YES+x} ]]; then
        had_assume_yes=true
    fi

    # Parse only leading global/scope options. This keeps query text available
    # for fzf while making `fsys user services ssh` and `fsys --yes service`
    # predictable.
    while (($#)); do
        case $1 in
            -u|--user)
                scope=user
                explicit_scope=true
                shift
                ;;
            -s|--system)
                scope=system
                explicit_scope=true
                shift
                ;;
            -y|--yes|--no-confirm)
                FSYS_ASSUME_YES=1
                export FSYS_ASSUME_YES
                shift
                ;;
            -h|--help)
                _fsys__help
                if [[ $had_assume_yes == true ]]; then
                    FSYS_ASSUME_YES=$old_assume_yes
                    export FSYS_ASSUME_YES
                else
                    unset FSYS_ASSUME_YES
                fi
                return 0
                ;;
            --version)
                _fsys__version
                if [[ $had_assume_yes == true ]]; then
                    FSYS_ASSUME_YES=$old_assume_yes
                    export FSYS_ASSUME_YES
                else
                    unset FSYS_ASSUME_YES
                fi
                return 0
                ;;
            --)
                shift
                break
                ;;
            system|user)
                scope=$1
                explicit_scope=true
                shift
                ;;
            service|services|svc|timer|timers|unit|units|unit-file|unit-files|failed|log|logs|journal|boot|boots|overview|status|linger)
                command=$1
                shift
                break
                ;;
            -* )
                _fsys__usage_error "unknown option: $1"
                local rc=$?
                if [[ $had_assume_yes == true ]]; then
                    FSYS_ASSUME_YES=$old_assume_yes
                    export FSYS_ASSUME_YES
                else
                    unset FSYS_ASSUME_YES
                fi
                return "$rc"
                ;;
            *)
                # Treat an unrecognized first word as a command so typos are
                # reported rather than silently becoming fzf queries.
                command=$1
                shift
                break
                ;;
        esac
    done

    # Everything after the command becomes fzf's initial query.
    if (($#)); then
        query=$*
    fi

    local rc=0
    case $command in
        service|services|svc)
            _fsys__services "$scope" "$query"
            rc=$?
            ;;
        timer|timers)
            _fsys__timers "$scope" "$query"
            rc=$?
            ;;
        unit|units)
            _fsys__units "$scope" "$query"
            rc=$?
            ;;
        unit-file|unit-files)
            _fsys__unit_files "$scope" "$query"
            rc=$?
            ;;
        failed)
            _fsys__failed "$scope" "$query"
            rc=$?
            ;;
        log|logs|journal)
            _fsys__logs "$scope" "$query"
            rc=$?
            ;;
        boot|boots)
            _fsys__boots "$scope"
            rc=$?
            ;;
        overview|status)
            _fsys__overview "$scope"
            rc=$?
            ;;
        linger)
            _fsys__linger
            rc=$?
            ;;
        '')
            if [[ $explicit_scope == true ]]; then
                _fsys__scope_menu "$scope"
            else
                _fsys__menu
            fi
            rc=$?
            ;;
        *)
            _fsys__usage_error "unknown command: $command"
            rc=$?
            ;;
    esac

    # Restore FSYS_ASSUME_YES if the caller already had one, or remove the
    # temporary value created by this invocation. Do this even after failures.
    if [[ $had_assume_yes == true ]]; then
        FSYS_ASSUME_YES=$old_assume_yes
        export FSYS_ASSUME_YES
    else
        unset FSYS_ASSUME_YES
    fi

    return "$rc"
}

