#!/usr/bin/env bash

# fdoc.bash - fzf-driven Docker and Docker Compose operations for Bash
#
# Purpose:
#   Provide a compact K9s-like terminal UI for the Docker Engine and
#   Docker Compose using only Bash, Docker CLI, Docker Compose and fzf.
#
# Public command:
#   fdoc                         choose Docker resource type
#   fdoc containers              container browser
#   fdoc images                 image browser
#   fdoc volumes                volume browser
#   fdoc networks               network browser
#   fdoc compose                current Compose project's services
#   fdoc ctx                    Docker context browser
#
# Launch examples:
#   fdoc containers nginx
#   fdoc containers -c production
#   fdoc compose -f compose.yaml
#   fdoc compose -f compose.yaml -f compose.prod.yaml
#   fdoc compose -p myproject
#
# Design:
#   - fzf uses --exact by default.
#   - Preview is hidden by default. Your existing Ctrl-/ binding can toggle it.
#   - The UI receives one preformatted display field, so there are no literal
#     "\\t" artifacts and columns stay aligned with long names.
#   - Raw identifiers remain in separate hidden fzf fields and are used for
#     all Docker actions. Presentation formatting can therefore never corrupt
#     the object name used by an action.
#   - fzf child commands run through Bash, and all required helper functions
#     are exported so execute/preview/reload bindings work from child shells.
#
# Optional tools:
#   bat       preferred renderer for JSON/YAML/text
#   less      pager fallback when bat is unavailable
#   wl-copy   Wayland clipboard
#   xclip     X11 clipboard
#   xsel      X11 clipboard
#   pbcopy    macOS clipboard
#
# Safety / compatibility notes:
#   - This file is sourceable: sourcing it defines fdoc and its private helpers
#     without running Docker or fzf. Executing it directly runs `fdoc "$@"`.
#   - The implementation deliberately does NOT use `set -e`, `set -u`, or
#     `set -o pipefail` globally because sourcing must not alter the caller's
#     shell semantics. Functions use explicit error handling instead.
#   - Invocation state is kept in function-local exported FDOC_* variables, so
#     one `fdoc` invocation cannot leak context/Compose settings into later
#     shell commands.
#   - Destructive operations require an explicit confirmation by default.
#   - Docker context switching is intentionally still persistent, because that
#     is the documented behavior of `docker context use`; deleting a context
#     is always confirmed.
#
# Version: 2.0.0

# Public version string. Keep this simple so `fdoc --version` is cheap and
# works even before Docker/fzf are installed.
_FDOC_VERSION='2.0.0'

# Return success when a command is available in PATH. Keeping this as a
# function makes the optional-tool checks easy to reuse and test.
_fdoc__have() {
    command -v "$1" >/dev/null 2>&1
}

# Print an error consistently and return a caller-friendly status.
_fdoc__error() {
    printf 'fdoc: %s\n' "$*" >&2
}

# Read from the controlling terminal instead of fzf's stdin. All interactive
# actions use this helper so they keep working from an fzf execute binding.
_fdoc__read_tty() {
    local __fd_in=${1:-/dev/tty}
    shift || true
    IFS= read -r "$@" <"$__fd_in"
}

# Refuse interactive prompts when there is no controlling terminal. This is
# safer than accidentally reading data from a pipe or from an fzf selection.
_fdoc__require_tty() {
    [[ -r /dev/tty && -w /dev/tty ]] || {
        _fdoc__error 'interactive confirmation/input requires a controlling terminal'
        return 2
    }
}

# Validate a numeric value used by Compose scaling. Bash arithmetic is not used
# directly on user input, avoiding accidental evaluation of shell expressions.
_fdoc__is_uint() {
    [[ ${1-} =~ ^[0-9]+$ ]]
}

# -----------------------------------------------------------------------------
# Common helpers
# -----------------------------------------------------------------------------

_fdoc__require_commands() {
    local missing=()
    local cmd

    for cmd in docker fzf; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done

    if ((${#missing[@]})); then
        printf 'fdoc: missing command(s): %s\n' "${missing[*]}" >&2
        return 127
    fi
}

_fdoc__require_compose() {
    _fdoc__require_commands || return

    _fdoc__docker compose version >/dev/null 2>&1 || {
        printf 'fdoc: Docker Compose is unavailable. Try `docker compose version`.\n' >&2
        return 127
    }
}

# Run Docker while optionally forcing a context for this fdoc invocation.
# FDOC_CONTEXT never changes the user's persistent Docker configuration.
_fdoc__docker() {
    local -a args=()

    if [[ -n ${FDOC_CONTEXT:-} ]]; then
        args+=(--context "$FDOC_CONTEXT")
    fi

    command docker "${args[@]}" "$@"
}

# Build one Docker Compose command from environment-backed invocation state.
# Newlines are used internally because they survive export to fzf child Bash
# processes without requiring eval or shell-quoting tricks.
_fdoc__compose() {
    local -a args=()
    local file profile env_file

    if [[ -n ${FDOC_COMPOSE_FILES:-} ]]; then
        while IFS= read -r file; do
            [[ -n $file ]] || continue
            args+=(-f "$file")
        done <<< "$FDOC_COMPOSE_FILES"
    fi

    if [[ -n ${FDOC_PROJECT_NAME:-} ]]; then
        args+=(-p "$FDOC_PROJECT_NAME")
    fi

    if [[ -n ${FDOC_PROJECT_DIRECTORY:-} ]]; then
        args+=(--project-directory "$FDOC_PROJECT_DIRECTORY")
    fi

    if [[ -n ${FDOC_PROFILES:-} ]]; then
        while IFS= read -r profile; do
            [[ -n $profile ]] || continue
            args+=(--profile "$profile")
        done <<< "$FDOC_PROFILES"
    fi

    if [[ -n ${FDOC_COMPOSE_ENV_FILES:-} ]]; then
        while IFS= read -r env_file; do
            [[ -n $env_file ]] || continue
            args+=(--env-file "$env_file")
        done <<< "$FDOC_COMPOSE_ENV_FILES"
    fi

    _fdoc__docker compose "${args[@]}" "$@"
}

_fdoc__pause() {
    # Actions launched by fzf normally still have a controlling terminal, but
    # do not hang indefinitely when fdoc is embedded in a non-interactive job.
    if [[ ! -r /dev/tty ]]; then
        return 0
    fi

    printf '\nPress Enter to return to fzf...' >&2
    IFS= read -r _ </dev/tty
}

# Render preview/action output. bat is used when available; cat is deliberately
# used as the fallback because less/pagers are awkward inside fzf previews.
_fdoc__render() {
    local language=${1:-text}

    if command -v bat >/dev/null 2>&1; then
        if [[ $language == text ]]; then
            bat --style=plain --color=always --paging=never 2>/dev/null
        else
            bat --style=plain --color=always --paging=never \
                --language="$language" 2>/dev/null
        fi
    else
        cat
    fi
}

# Page action output after Enter/Ctrl-Y. A pipe into bat is intentionally not
# used here: bat treats piped input as non-interactive. Writing the result to a
# temporary file allows --paging=always to invoke the configured pager.
_fdoc__page_file() {
    local language=${1:-text}
    local file=$2

    [[ -r $file ]] || return 1

    if command -v bat >/dev/null 2>&1; then
        if [[ $language == text ]]; then
            bat --style=plain --color=always --paging=always "$file"
        else
            bat --style=plain --color=always --paging=always \
                --language="$language" "$file"
        fi
    elif command -v less >/dev/null 2>&1; then
        less -R "$file"
    else
        cat "$file"
    fi
}

# Interactive renderer for actions launched by Enter/Ctrl-Y.  bat only uses
# an interactive pager when its input is a terminal/file; stdin from a pipe is
# treated as non-interactive.  Materialize the action output into a temporary
# file first, then let bat page that file.  less is the secondary fallback and
# cat is the final fallback.
_fdoc__page() {
    local language=${1:-text}
    local tmp rc=0

    tmp=$(mktemp "${TMPDIR:-/tmp}/fdoc.XXXXXX") || {
        cat
        return 0
    }

    cat > "$tmp"

    if command -v bat >/dev/null 2>&1; then
        if [[ $language == text ]]; then
            bat --style=plain --color=always --paging=always "$tmp" || rc=$?
        else
            bat --style=plain --color=always --paging=always \
                --language="$language" "$tmp" || rc=$?
        fi
    elif command -v less >/dev/null 2>&1; then
        less -R "$tmp" || rc=$?
    else
        cat "$tmp" || rc=$?
    fi

    rm -f "$tmp"
    return "$rc"
}

_fdoc__clip() {
    # Do not silently report success when there is no clipboard integration.
    # The selected value is also printed in that case, so clipboard actions
    # remain useful on minimal servers.
    local value rc=0
    value=$(cat) || rc=$?
    ((rc == 0)) || return "$rc"

    if _fdoc__have wl-copy; then
        printf '%s' "$value" | wl-copy
    elif _fdoc__have xclip; then
        printf '%s' "$value" | xclip -selection clipboard
    elif _fdoc__have xsel; then
        printf '%s' "$value" | xsel --clipboard --input
    elif _fdoc__have pbcopy; then
        printf '%s' "$value" | pbcopy
    else
        printf '%s\n' "$value"
        return 1
    fi
}

_fdoc__confirm() {
    local prompt=${1:-'Continue?'}
    local answer

    _fdoc__require_tty || return 2
    printf '%s [y/N] ' "$prompt" > /dev/tty
    IFS= read -r answer </dev/tty || return 1
    [[ $answer =~ ^[Yy]([Ee][Ss])?$ ]]
}

# -----------------------------------------------------------------------------
# Docker resource listings
# -----------------------------------------------------------------------------

# Internal container row:
#   ID<TAB>NAME<TAB>IMAGE<TAB>STATE<TAB>STATUS<TAB>DISPLAY
_fdoc__containers_list() {
    _fdoc__docker ps -a --format '{{.ID}}{{"\t"}}{{.Names}}{{"\t"}}{{.Image}}{{"\t"}}{{.State}}{{"\t"}}{{.Status}}{{"\t"}}{{.Ports}}' 2>/dev/null |
        awk -F '\t' '
            {
                id[++n] = $1
                name[n] = $2
                image[n] = $3
                state[n] = $4
                status[n] = $5
                ports[n] = $6

                if (length(name[n]) > w1) w1 = length(name[n])
                if (length(image[n]) > w2) w2 = length(image[n])
                if (length(state[n]) > w3) w3 = length(state[n])
                if (length(status[n]) > w4) w4 = length(status[n])
            }
            END {
                for (i = 1; i <= n; i++)
                    printf "%s\t%s\t%s\t%s\t%s\t%-*s  %-*s  %-*s  %-*s  %s\n", \
                        id[i], name[i], image[i], state[i], status[i], \
                        w1, name[i], w2, image[i], w3, state[i], w4, status[i], ports[i]
            }
        '
}

# Image row:
#   ID<TAB>REPOSITORY<TAB>TAG<TAB>SIZE<TAB>CREATED<TAB>DISPLAY
_fdoc__images_list() {
    _fdoc__docker image ls --no-trunc --format '{{.ID}}{{"\t"}}{{.Repository}}{{"\t"}}{{.Tag}}{{"\t"}}{{.Size}}{{"\t"}}{{.CreatedSince}}' 2>/dev/null |
        awk -F '\t' '
            {
                id[++n] = $1
                repo[n] = $2
                tag[n] = $3
                size[n] = $4
                created[n] = $5

                if (length(repo[n]) > w1) w1 = length(repo[n])
                if (length(tag[n]) > w2) w2 = length(tag[n])
                if (length(size[n]) > w3) w3 = length(size[n])
                if (length(created[n]) > w4) w4 = length(created[n])
            }
            END {
                for (i = 1; i <= n; i++)
                    printf "%s\t%s\t%s\t%s\t%s\t%-*s  %-*s  %-*s  %-*s\n", \
                        id[i], repo[i], tag[i], size[i], created[i], \
                        w1, repo[i], w2, tag[i], w3, size[i], w4, created[i]
            }
        '
}

