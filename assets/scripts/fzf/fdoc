_fdoc__resource_picker() {
    local resource=$1
    shift || true

    local initial_query=''
    (($#)) && initial_query=$*

    local list_cmd preview_cmd
    local -a args=(
        --with-shell='bash -c'
        --exact
        --multi
        --delimiter=$'\t'
        --prompt="Docker:$resource ❯❯❯ "
        --query="$initial_query"
        --header="$(_fdoc__header "$resource")"
        --preview-window='right:55%:hidden:wrap'
        --bind="ctrl-r:reload(_fdoc__${resource}_list)"
        --bind="enter:execute(_fdoc__action inspect '$resource' --file {+f})"
        --bind="ctrl-d:execute(_fdoc__action delete '$resource' --file {+f})+reload(_fdoc__${resource}_list)"
        --bind="ctrl-y:execute(_fdoc__action yaml '$resource' --file {+f})"
        --bind="alt-c:execute-silent(_fdoc__action copy-name '$resource' --file {+f})"
    )

    case $resource in
        containers)
            list_cmd='_fdoc__containers_list'
            preview_cmd='_fdoc__preview_container {2}'
            args+=(
                --with-nth=6
                --accept-nth='{2}'
                --preview="$preview_cmd"
                --bind='ctrl-l:execute(_fdoc__action logs containers --file {+f})'
                --bind='alt-l:execute(_fdoc__action logs-follow containers --file {+f})'
                --bind='ctrl-x:execute(_fdoc__action exec containers --file {+f})'
                --bind='alt-a:execute(_fdoc__action attach containers --file {+f})'
                --bind='ctrl-k:execute(_fdoc__action kill containers --file {+f})+reload(_fdoc__containers_list)'
                --bind='alt-n:execute(_fdoc__action rename containers --file {+f})+reload(_fdoc__containers_list)'
                --bind='alt-r:execute(_fdoc__action restart containers --file {+f})+reload(_fdoc__containers_list)'
                --bind='alt-s:execute(_fdoc__action toggle-start-stop containers --file {+f})+reload(_fdoc__containers_list)'
                --bind='alt-p:execute(_fdoc__action toggle-pause containers --file {+f})+reload(_fdoc__containers_list)'
                --bind='ctrl-t:execute(_fdoc__action top containers --file {+f})'
                --bind='ctrl-o:execute(_fdoc__action stats containers --file {+f})'
                --bind='alt-w:execute(_fdoc__action ports containers --file {+f})'
                --bind='alt-i:execute-silent(_fdoc__action copy-id containers --file {+f})'
                --bind='ctrl-p:execute(_fdoc__action prune containers --file {+f})+reload(_fdoc__containers_list)'
            )
            ;;
        images)
            list_cmd='_fdoc__images_list'
            preview_cmd='_fdoc__preview_image {1}'
            args+=(
                --with-nth=6
                --accept-nth='{1}'
                --preview="$preview_cmd"
                --bind='alt-u:execute(_fdoc__action history images --file {+f})'
                --bind='alt-c:execute-silent(_fdoc__action copy-name images --file {+f})'
                --bind='alt-i:execute-silent(_fdoc__action copy-id images --file {+f})'
                --bind='ctrl-p:execute(_fdoc__action prune images --file {+f})+reload(_fdoc__images_list)'
            )
            ;;
        volumes)
            list_cmd='_fdoc__volumes_list'
            preview_cmd='_fdoc__preview_volume {1}'
            args+=(
                --with-nth=4
                --accept-nth='{1}'
                --preview="$preview_cmd"
                --bind='ctrl-p:execute(_fdoc__action prune volumes --file {+f})+reload(_fdoc__volumes_list)'
            )
            ;;
        networks)
            list_cmd='_fdoc__networks_list'
            preview_cmd='_fdoc__preview_network {2}'
            args+=(
                --with-nth=5
                --accept-nth='{2}'
                --preview="$preview_cmd"
                --bind='ctrl-p:execute(_fdoc__action prune networks --file {+f})+reload(_fdoc__networks_list)'
            )
            ;;
        compose)
            list_cmd='_fdoc__compose_list'
            preview_cmd='_fdoc__preview_compose_service {1}'
            args+=(
                --with-nth=7
                --accept-nth='{1}'
                --prompt='Compose service ❯❯❯ '
                --preview="$preview_cmd"
                --bind='ctrl-l:execute(_fdoc__action logs compose --file {+f})'
                --bind='alt-l:execute(_fdoc__action logs-follow compose --file {+f})'
                --bind='ctrl-x:execute(_fdoc__action exec compose --file {+f})'
                --bind='alt-r:execute(_fdoc__action restart compose --file {+f})+reload(_fdoc__compose_list)'
                --bind='alt-s:execute(_fdoc__action toggle-start-stop compose --file {+f})+reload(_fdoc__compose_list)'
                --bind='alt-p:execute(_fdoc__action pause compose --file {+f})+reload(_fdoc__compose_list)'
                --bind='alt-u:execute(_fdoc__action unpause compose --file {+f})+reload(_fdoc__compose_list)'
                --bind='ctrl-t:execute(_fdoc__action top compose --file {+f})'
                --bind='alt-w:execute(_fdoc__action ports compose --file {+f})'
                --bind='alt-h:execute(_fdoc__action scale compose --file {+f})+reload(_fdoc__compose_list)'
                --bind='alt-g:execute(_fdoc__action pull compose --file {+f})' \
                --bind='alt-b:execute(_fdoc__action build compose --file {+f})+reload(_fdoc__compose_list)' \
                --bind='alt-c:execute-silent(_fdoc__action copy-name compose --file {+f})'
                --bind='alt-i:execute-silent(_fdoc__action copy-container compose --file {+f})'
            )
            ;;
        *)
            printf 'fdoc: unsupported resource type: %s\n' "$resource" >&2
            return 2
            ;;
    esac

    "$list_cmd" | fzf "${args[@]}"
}

