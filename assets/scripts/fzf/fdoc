# Main parser. Keep it separate from the public wrapper so helper export state
# can be cleaned up even when parsing or execution returns an error.
_fdoc__main() {
    # These are invocation-local and exported to fzf child processes. Because
    # they are `local`, an existing FDOC_* variable in the caller is preserved.
    local FDOC_CONTEXT=''
    local FDOC_COMPOSE_FILES=''
    local FDOC_PROJECT_NAME=''
    local FDOC_PROJECT_DIRECTORY=''
    local FDOC_PROFILES=''
    local FDOC_COMPOSE_ENV_FILES=''
    export FDOC_CONTEXT FDOC_COMPOSE_FILES FDOC_PROJECT_NAME \
        FDOC_PROJECT_DIRECTORY FDOC_PROFILES FDOC_COMPOSE_ENV_FILES

    local -a args=()
    local -a query=()
    local resource='' arg value

    # Global options may appear before the resource. Unlike a command-line
    # parser that uses eval, every value is kept as a literal array element.
    while (($#)); do
        arg=$1
        case $arg in
            -c|--context)
                (($# >= 2)) || {
                    _fdoc__error "$arg requires a context name"; return 2
                }
                FDOC_CONTEXT=$2
                shift 2
                ;;
            -c=*)
                FDOC_CONTEXT=${arg#-c=}
                [[ -n $FDOC_CONTEXT ]] || { _fdoc__error '-c requires a context name'; return 2; }
                shift
                ;;
            -c?*)
                FDOC_CONTEXT=${arg#-c}
                shift
                ;;
            --context=*)
                FDOC_CONTEXT=${arg#*=}
                shift
                ;;
            --version|-V)
                printf 'fdoc %s\n' "$_FDOC_VERSION"
                return 0
                ;;
            --help|-h)
                _fdoc__help
                return 0
                ;;
            --)
                shift
                args=("$@")
                break
                ;;
            -*)
                _fdoc__error "unknown global option: $arg"
                _fdoc__error 'run `fdoc --help` for usage'
                return 2
                ;;
            *)
                resource=$arg
                shift
                args=("$@")
                break
                ;;
        esac
    done

    # Help and version are local operations and must remain available even on
    # a host where Docker/fzf are not installed yet.
    case $resource in
        help)
            _fdoc__help
            return 0
            ;;
    esac

    _fdoc__require_commands || return $?

    case $resource in
        '')
            _fdoc__resource_types
            ;;

        ctx|context|contexts)
            # Context picker is a distinct mode because `docker context use`
            # intentionally changes the persistent Docker CLI context.
            if ((${#args[@]})); then
                case ${args[0]} in
                    --help|-h)
                        _fdoc__help
                        return 0
                        ;;
                esac
            fi
            _fdoc__contexts "${args[@]}"
            ;;

        containers|container|ps|images|image|img|volumes|volume|vol|networks|network|net)
            # Engine resources accept a query plus an optional invocation-local
            # context. Query text after `--` is always treated literally.
            while ((${#args[@]})); do
                arg=${args[0]}
                args=("${args[@]:1}")
                case $arg in
                    -c|--context)
                        ((${#args[@]})) || {
                            _fdoc__error "$arg requires a context name"; return 2
                        }
                        FDOC_CONTEXT=${args[0]}
                        args=("${args[@]:1}")
                        ;;
                    -c=*)
                        FDOC_CONTEXT=${arg#-c=}
                        [[ -n $FDOC_CONTEXT ]] || { _fdoc__error '-c requires a context name'; return 2; }
                        ;;
                    -c?*)
                        FDOC_CONTEXT=${arg#-c}
                        ;;
                    --context=*)
                        FDOC_CONTEXT=${arg#*=}
                        ;;
                    --help|-h)
                        _fdoc__help
                        return 0
                        ;;
                    --)
                        query+=("${args[@]}")
                        args=()
                        ;;
                    *)
                        query+=("$arg")
                        ;;
                esac
            done

            case $resource in
                containers|container|ps)
                    _fdoc__resource_picker containers "${query[@]}"
                    ;;
                images|image|img)
                    _fdoc__resource_picker images "${query[@]}"
                    ;;
                volumes|volume|vol)
                    _fdoc__resource_picker volumes "${query[@]}"
                    ;;
                networks|network|net)
                    _fdoc__resource_picker networks "${query[@]}"
                    ;;
            esac
            ;;

        compose|composes|services|service)
            # Only a documented, finite set of Compose top-level options is
            # parsed here. Unknown options are rejected instead of accidentally
            # becoming a search query, which prevents surprising behavior.
            while ((${#args[@]})); do
                arg=${args[0]}
                args=("${args[@]:1}")
                case $arg in
                    -c|--context)
                        ((${#args[@]})) || {
                            _fdoc__error "$arg requires a context name"; return 2
                        }
                        FDOC_CONTEXT=${args[0]}
                        args=("${args[@]:1}")
                        ;;
                    -c=*)
                        FDOC_CONTEXT=${arg#-c=}
                        [[ -n $FDOC_CONTEXT ]] || { _fdoc__error '-c requires a context name'; return 2; }
                        ;;
                    -c?*)
                        FDOC_CONTEXT=${arg#-c}
                        ;;
                    --context=*)
                        FDOC_CONTEXT=${arg#*=}
                        ;;
                    -f|--file)
                        ((${#args[@]})) || {
                            _fdoc__error "$arg requires a Compose file"; return 2
                        }
                        FDOC_COMPOSE_FILES+="${FDOC_COMPOSE_FILES:+$'\n'}${args[0]}"
                        args=("${args[@]:1}")
                        ;;
                    -f=*)
                        value=${arg#-f=}
                        [[ -n $value ]] || {
                            _fdoc__error '-f requires a Compose file'; return 2
                        }
                        FDOC_COMPOSE_FILES+="${FDOC_COMPOSE_FILES:+$'\n'}$value"
                        ;;
                    -f?*)
                        value=${arg#-f}
                        [[ -n $value ]] || {
                            _fdoc__error '-f requires a Compose file'; return 2
                        }
                        FDOC_COMPOSE_FILES+="${FDOC_COMPOSE_FILES:+$'\n'}$value"
                        ;;
                    --file=*)
                        value=${arg#*=}
                        [[ -n $value ]] || {
                            _fdoc__error '--file requires a Compose file'; return 2
                        }
                        FDOC_COMPOSE_FILES+="${FDOC_COMPOSE_FILES:+$'\n'}$value"
                        ;;
                    -p|--project-name)
                        ((${#args[@]})) || {
                            _fdoc__error "$arg requires a project name"; return 2
                        }
                        FDOC_PROJECT_NAME=${args[0]}
                        args=("${args[@]:1}")
                        ;;
                    -p=*)
                        FDOC_PROJECT_NAME=${arg#-p=}
                        [[ -n $FDOC_PROJECT_NAME ]] || {
                            _fdoc__error '-p requires a project name'; return 2
                        }
                        ;;
                    -p?*)
                        FDOC_PROJECT_NAME=${arg#-p}
                        ;;
                    --project-name=*)
                        FDOC_PROJECT_NAME=${arg#*=}
                        ;;
                    --project-directory)
                        ((${#args[@]})) || {
                            _fdoc__error '--project-directory requires a directory'; return 2
                        }
                        FDOC_PROJECT_DIRECTORY=${args[0]}
                        args=("${args[@]:1}")
                        ;;
                    --project-directory=*)
                        FDOC_PROJECT_DIRECTORY=${arg#*=}
                        ;;
                    --profile)
                        ((${#args[@]})) || {
                            _fdoc__error '--profile requires a profile name'; return 2
                        }
                        FDOC_PROFILES+="${FDOC_PROFILES:+$'\n'}${args[0]}"
                        args=("${args[@]:1}")
                        ;;
                    --profile=*)
                        value=${arg#*=}
                        [[ -n $value ]] || {
                            _fdoc__error '--profile requires a profile name'; return 2
                        }
                        FDOC_PROFILES+="${FDOC_PROFILES:+$'\n'}$value"
                        ;;
                    --env-file)
                        ((${#args[@]})) || {
                            _fdoc__error '--env-file requires a file'; return 2
                        }
                        FDOC_COMPOSE_ENV_FILES+="${FDOC_COMPOSE_ENV_FILES:+$'\n'}${args[0]}"
                        args=("${args[@]:1}")
                        ;;
                    --env-file=*)
                        value=${arg#*=}
                        [[ -n $value ]] || {
                            _fdoc__error '--env-file requires a file'; return 2
                        }
                        FDOC_COMPOSE_ENV_FILES+="${FDOC_COMPOSE_ENV_FILES:+$'\n'}$value"
                        ;;
                    --)
                        query+=("${args[@]}")
                        args=()
                        ;;
                    --help|-h)
                        _fdoc__help
                        return 0
                        ;;
                    *)
                        # A leading-dash argument is almost certainly a typo in
                        # a Compose option. Require `--` when the user really
                        # wants it as the initial search query.
                        if [[ $arg == -* ]]; then
                            _fdoc__error "unknown Compose option: $arg"
                            _fdoc__error 'use `--` before a query that begins with -'
                            return 2
                        fi
                        query+=("$arg")
                        ;;
                esac
            done

            _fdoc__require_compose || return $?
            _fdoc__resource_picker compose "${query[@]}"
            ;;

        resource|resources|type|types)
            query=("${args[@]}")
            _fdoc__resource_types "${query[*]}"
            ;;

        *)
            _fdoc__error "unknown resource: $resource"
            _fdoc__error 'run `fdoc --help` or just `fdoc` to choose a resource'
            return 2
            ;;
    esac
}

# Public entry point. Sourcing the file never invokes this automatically.
fdoc() {
    _fdoc__export_helpers
    local rc

    # Put the main call in a conditional so callers with `set -e` do not have
    # their shell terminated before we can remove the temporary exports.
    if _fdoc__main "$@"; then
        rc=0
    else
        rc=$?
    fi

    _fdoc__unexport_helpers
    return "$rc"
}

# When sourced, only definitions above are evaluated. When executed directly,
# behave like a normal command-line script while still keeping all parsing in
# the sourceable `fdoc` function.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    fdoc "$@"
    exit $?
fi

