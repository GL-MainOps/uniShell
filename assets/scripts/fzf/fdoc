# Compose service/container row:
#   SERVICE<TAB>CONTAINER<TAB>STATE<TAB>HEALTH<TAB>IMAGE<TAB>PORTS<TAB>DISPLAY
#
# `docker compose ps --all` intentionally drives this list. It shows both
# running and stopped containers and is the Compose-supported snapshot of the
# current project's service state.
_fdoc__compose_list() {
    _fdoc__compose ps --all --format '{{.Service}}{{"\t"}}{{.Name}}{{"\t"}}{{.State}}{{"\t"}}{{.Health}}{{"\t"}}{{.Image}}{{"\t"}}{{.Ports}}' 2>/dev/null |
        awk -F '\t' '
            {
                service[++n] = $1
                container[n] = $2
                state[n] = $3
                health[n] = ($4 == "" ? "-" : $4)
                image[n] = $5
                ports[n] = $6

                if (length(service[n]) > w1) w1 = length(service[n])
                if (length(container[n]) > w2) w2 = length(container[n])
                if (length(state[n]) > w3) w3 = length(state[n])
                if (length(health[n]) > w4) w4 = length(health[n])
                if (length(image[n]) > w5) w5 = length(image[n])
            }
            END {
                for (i = 1; i <= n; i++)
                    printf "%s\t%s\t%s\t%s\t%s\t%s\t%-*s  %-*s  %-*s  %-*s  %-*s  %s\n", \
                        service[i], container[i], state[i], health[i], image[i], ports[i], \
                        w1, service[i], w2, container[i], w3, state[i], w4, health[i], \
                        w5, image[i], ports[i]
            }
        '
}

# -----------------------------------------------------------------------------
# Docker context listing
# -----------------------------------------------------------------------------

_fdoc__contexts_list() {
    local current
    current=$(_fdoc__docker context show 2>/dev/null || true)

    _fdoc__docker context ls --format '{{.Name}}{{"\t"}}{{.Description}}{{"\t"}}{{.DockerEndpoint}}{{"\t"}}{{.Orchestrator}}' 2>/dev/null |
        awk -F '\t' -v current="$current" '
            {
                name[++n] = $1
                desc[n] = ($2 == "" ? "-" : $2)
                endpoint[n] = ($3 == "" ? "-" : $3)
                orchestrator[n] = ($4 == "" ? "-" : $4)
                mark[n] = ($1 == current ? "*" : " ")

                if (length(name[n]) > w1) w1 = length(name[n])
                if (length(desc[n]) > w2) w2 = length(desc[n])
                if (length(endpoint[n]) > w3) w3 = length(endpoint[n])
            }
            END {
                for (i = 1; i <= n; i++)
                   printf "%s\t%s\t%s\t%s\t%s\t%s %-*s  %-*s  %-*s  %s\n", \
                       name[i], desc[i], endpoint[i], orchestrator[i], mark[i], mark[i], \
                       w1, name[i], w2, desc[i], w3, endpoint[i], orchestrator[i]
            }
        '
}

# -----------------------------------------------------------------------------
# Preview functions
# -----------------------------------------------------------------------------

_fdoc__preview_container() {
    local name=$1
    [[ -n $name ]] || return 0
    _fdoc__docker inspect "$name" 2>&1 | _fdoc__render json
}

_fdoc__preview_image() {
    local id=$1
    [[ -n $id ]] || return 0
    _fdoc__docker image inspect "$id" 2>&1 | _fdoc__render json
}

_fdoc__preview_volume() {
    local name=$1
    [[ -n $name ]] || return 0
    _fdoc__docker volume inspect "$name" 2>&1 | _fdoc__render json
}

_fdoc__preview_network() {
    local name=$1
    [[ -n $name ]] || return 0
    _fdoc__docker network inspect "$name" 2>&1 | _fdoc__render json
}

_fdoc__preview_compose_service() {
    local service=$1
    [[ -n $service ]] || return 0

    # Prefer the service's actual containers. If the service has not yet been
    # created, fall back to the resolved Compose model so preview is not empty.
    local result
    result=$(_fdoc__compose ps --all --format json "$service" 2>&1)
    if [[ -n $result && $result != '[]' ]]; then
        printf '%s\n' "$result" | _fdoc__render json
    else
        _fdoc__compose config --format json 2>&1 | _fdoc__render json
    fi
}

_fdoc__preview_context() {
    local context=$1
    [[ -n $context ]] || return 0
    _fdoc__docker context inspect "$context" 2>&1 | _fdoc__render json
}

# -----------------------------------------------------------------------------
# Action dispatcher
# -----------------------------------------------------------------------------

_fdoc__action() {
    local action=$1
    local resource=$2

    [[ ${3-} == --file ]] || {
        printf 'fdoc: internal error: expected --file <fzf temp file>\n' >&2
        return 2
    }

    local file=${4-}
    [[ -r $file ]] || {
        printf 'fdoc: selection file is not readable\n' >&2
        return 2
    }

    local -a f1=() f2=() f3=() f4=() f5=() f6=()
    local a b c d e f

    while IFS=$'\t' read -r a b c d e f; do
        [[ -n $a ]] || continue
        f1+=("$a")
        f2+=("$b")
        f3+=("$c")
        f4+=("$d")
        f5+=("$e")
        f6+=("$f")
    done < "$file"

    ((${#f1[@]})) || return 0

    local i

    case $resource in
        containers)
            case $action in
                inspect|yaml)
                    local page_file
                    page_file=$(mktemp "${TMPDIR:-/tmp}/fdoc-inspect.XXXXXX") || return 1
                    for i in "${!f2[@]}"; do
                        printf '\n===== %s =====\n' "${f2[i]}" >> "$page_file"
                        _fdoc__docker inspect "${f2[i]}" >> "$page_file" 2>&1
                    done
                    _fdoc__page_file json "$page_file"
                    local page_rc=$?
                    rm -f "$page_file"
                    return "$page_rc"
                    ;;
                delete)
                    printf 'Selected container(s):\n'
                    for i in "${!f2[@]}"; do printf '  %s\n' "${f2[i]}"; done
                    printf '\n'
                    _fdoc__confirm "Remove ${#f2[@]} container(s)?" || return 0
                    _fdoc__docker rm "${f2[@]}"
                    ;;
                logs)
                    for i in "${!f2[@]}"; do
                        printf '\n===== %s =====\n' "${f2[i]}"
                        _fdoc__docker logs --tail 200 "${f2[i]}"
                    done
                    _fdoc__pause
                    ;;
                logs-follow)
                    ((${#f2[@]} == 1)) || {
                        printf 'fdoc: follow logs requires exactly one selected container.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    _fdoc__docker logs -f --tail 200 "${f2[0]}"
                    ;;
                exec)
                    ((${#f2[@]} == 1)) || {
                        printf 'fdoc: exec requires exactly one selected container.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    if _fdoc__docker exec "${f2[0]}" /bin/bash -c 'exit 0' >/dev/null 2>&1; then
                        _fdoc__docker exec -it "${f2[0]}" /bin/bash -il
                    else
                        _fdoc__docker exec -it "${f2[0]}" /bin/sh
                    fi
                    ;;
                attach)
                    ((${#f2[@]} == 1)) || {
                        printf 'fdoc: attach requires exactly one selected container.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    _fdoc__docker attach "${f2[0]}"
                    ;;
                kill)
                    printf 'Selected container(s):\n'
                    for i in "${!f2[@]}"; do printf '  %s\n' "${f2[i]}"; done
                    printf '\n'
                    _fdoc__confirm "Kill ${#f2[@]} container(s)?" || return 0
                    _fdoc__docker kill "${f2[@]}"
                    ;;
                rename)
                    ((${#f2[@]} == 1)) || {
                        printf 'fdoc: rename requires exactly one selected container.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    local new_name
                    printf 'New name for %s: ' "${f2[0]}" > /dev/tty
                    IFS= read -r new_name </dev/tty || return 1
                    [[ -n $new_name ]] || return 0
                    _fdoc__docker rename "${f2[0]}" "$new_name"
                    ;;
                restart)
                    _fdoc__docker restart "${f2[@]}"
                    ;;
                toggle-start-stop)
                    for i in "${!f2[@]}"; do
                        if [[ ${f4[i]} == running ]]; then
                            _fdoc__docker stop "${f2[i]}"
                        else
                            _fdoc__docker start "${f2[i]}"
                        fi
                    done
                    ;;
                toggle-pause)
                    for i in "${!f2[@]}"; do
                        local paused
                        paused=$(_fdoc__docker inspect -f '{{.State.Paused}}' "${f2[i]}" 2>/dev/null)
                        if [[ $paused == true ]]; then
                            _fdoc__docker unpause "${f2[i]}"
                        else
                            _fdoc__docker pause "${f2[i]}"
                        fi
                    done
                    ;;
                top)
                    for i in "${!f2[@]}"; do
                        printf '\n===== %s =====\n' "${f2[i]}"
                        _fdoc__docker top "${f2[i]}"
                    done
                    _fdoc__pause
                    ;;
                stats)
                    _fdoc__docker stats --no-stream "${f2[@]}"
                    _fdoc__pause
                    ;;
                ports)
                    for i in "${!f2[@]}"; do
                        printf '\n===== %s =====\n' "${f2[i]}"
                        _fdoc__docker port "${f2[i]}"
                    done
                    _fdoc__pause
                    ;;
                copy-name)
                    printf '%s\n' "${f2[@]}" | _fdoc__clip
                    ;;
                copy-id)
                    printf '%s\n' "${f1[@]}" | _fdoc__clip
                    ;;
                prune)
                   _fdoc__confirm 'Prune all stopped containers?' || return 0
                   _fdoc__docker container prune -f
                   ;;
            esac
            ;;

        images)
            case $action in
                inspect|yaml)
                    local page_file
                    page_file=$(mktemp "${TMPDIR:-/tmp}/fdoc-inspect.XXXXXX") || return 1
                    for i in "${!f1[@]}"; do
                        printf '\n===== %s:%s =====\n' "${f2[i]}" "${f3[i]}" >> "$page_file"
                        _fdoc__docker image inspect "${f1[i]}" >> "$page_file" 2>&1
                    done
                    _fdoc__page_file json "$page_file"
                    local page_rc=$?
                    rm -f "$page_file"
                    return "$page_rc"
                    ;;
                delete)
                    printf 'Selected image(s):\n'
                    for i in "${!f1[@]}"; do printf '  %s:%s\n' "${f2[i]}" "${f3[i]}"; done
                    printf '\n'
                    _fdoc__confirm "Remove ${#f1[@]} image(s)?" || return 0
                    _fdoc__docker image rm "${f1[@]}"
                    ;;
                history)
                    for i in "${!f1[@]}"; do
                        printf '\n===== %s:%s =====\n' "${f2[i]}" "${f3[i]}"
                        _fdoc__docker image history "${f1[i]}"
                    done
                    _fdoc__pause
                    ;;
                copy-name)
                    for i in "${!f2[@]}"; do printf '%s:%s\n' "${f2[i]}" "${f3[i]}"; done | _fdoc__clip
                    ;;
                copy-id)
                    printf '%s\n' "${f1[@]}" | _fdoc__clip
                    ;;
                prune)
                    _fdoc__confirm 'Prune all dangling images?' || return 0
                    _fdoc__docker image prune -f
                    ;;
            esac
            ;;

        volumes)
            case $action in
                inspect|yaml)
                    local page_file
                    page_file=$(mktemp "${TMPDIR:-/tmp}/fdoc-inspect.XXXXXX") || return 1
                    for i in "${!f1[@]}"; do
                        printf '\n===== %s =====\n' "${f1[i]}" >> "$page_file"
                        _fdoc__docker volume inspect "${f1[i]}" >> "$page_file" 2>&1
                    done
                    _fdoc__page_file json "$page_file"
                    local page_rc=$?
                    rm -f "$page_file"
                    return "$page_rc"
                    ;;
                delete)
                    printf 'Selected volume(s):\n'
                    for i in "${!f1[@]}"; do printf '  %s\n' "${f1[i]}"; done
                    printf '\n'
                    _fdoc__confirm "Remove ${#f1[@]} volume(s)?" || return 0
                    _fdoc__docker volume rm "${f1[@]}"
                    ;;
                copy-name)
                    printf '%s\n' "${f1[@]}" | _fdoc__clip
                    ;;
                prune)
                    _fdoc__confirm 'Prune all unused volumes?' || return 0
                    _fdoc__docker volume prune -f
                    ;;
            esac
            ;;

        networks)
            case $action in
                inspect|yaml)
                    local page_file
                    page_file=$(mktemp "${TMPDIR:-/tmp}/fdoc-inspect.XXXXXX") || return 1
                    for i in "${!f2[@]}"; do
                        printf '\n===== %s =====\n' "${f2[i]}" >> "$page_file"
                        _fdoc__docker network inspect "${f2[i]}" >> "$page_file" 2>&1
                    done
                    _fdoc__page_file json "$page_file"
                    local page_rc=$?
                    rm -f "$page_file"
                    return "$page_rc"
                    ;;
                delete)
                    printf 'Selected network(s):\n'
                    for i in "${!f2[@]}"; do printf '  %s\n' "${f2[i]}"; done
                    printf '\n'
                    _fdoc__confirm "Remove ${#f2[@]} network(s)?" || return 0
                    _fdoc__docker network rm "${f2[@]}"
                    ;;
                copy-name)
                    printf '%s\n' "${f2[@]}" | _fdoc__clip
                    ;;
                prune)
                    _fdoc__confirm 'Prune all unused networks?' || return 0
                    _fdoc__docker network prune -f
                    ;;
            esac
            ;;

        compose)
            case $action in
                inspect)
                    local page_file
                    page_file=$(mktemp "${TMPDIR:-/tmp}/fdoc-inspect.XXXXXX") || return 1
                    for i in "${!f1[@]}"; do
                        printf '\n===== service: %s =====\n' "${f1[i]}" >> "$page_file"
                        _fdoc__compose ps --all --format json "${f1[i]}" >> "$page_file" 2>&1
                    done
                    _fdoc__page_file json "$page_file"
                    local page_rc=$?
                    rm -f "$page_file"
                    return "$page_rc"
                    ;;
                config)
                    local config_file config_rc page_rc
                    config_file=$(mktemp "${TMPDIR:-/tmp}/fdoc-compose.XXXXXX") || return 1
                    config_rc=0
                    _fdoc__compose config --format yaml >"$config_file" 2>&1 || config_rc=$?
                    if ((config_rc != 0)); then
                        _fdoc__page_file yaml "$config_file"
                        page_rc=$?
                        rm -f "$config_file"
                        return "$config_rc"
                    fi
                    _fdoc__page_file yaml "$config_file"
                    page_rc=$?
                    rm -f "$config_file"
                    _fdoc__pause
                    return "$page_rc"
                    ;;
                delete)
                    printf 'Selected Compose service(s):\n'
                    for i in "${!f1[@]}"; do printf '  %s\n' "${f1[i]}"; done
                    printf '\nOnly stopped service containers are removed by `docker compose rm`.\n'
                    _fdoc__confirm "Remove selected stopped service container(s)?" || return 0
                    _fdoc__compose rm -f "${f1[@]}"
                    ;;
                logs)
                    for i in "${!f1[@]}"; do
                        printf '\n===== %s =====\n' "${f1[i]}"
                        _fdoc__compose logs --tail 200 "${f1[i]}"
                    done
                    _fdoc__pause
                    ;;
                logs-follow)
                    ((${#f1[@]} == 1)) || {
                        printf 'fdoc: follow logs requires exactly one selected service.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    _fdoc__compose logs -f --tail 200 "${f1[0]}"
                    ;;
                exec)
                    ((${#f1[@]} == 1)) || {
                        printf 'fdoc: exec requires exactly one selected service.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    local idx
                    printf 'Replica index [1]: ' > /dev/tty
                    IFS= read -r idx </dev/tty || return 1
                    idx=${idx:-1}
                    _fdoc__is_uint "$idx" || {
                        printf 'fdoc: replica index must be a non-negative integer.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    if _fdoc__compose exec --index "$idx" "${f1[0]}" /bin/bash -c 'exit 0' >/dev/null 2>&1; then
                        _fdoc__compose exec --index "$idx" "${f1[0]}" /bin/bash -il
                    else
                        _fdoc__compose exec --index "$idx" "${f1[0]}" /bin/sh
                    fi
                    ;;
                restart)
                    _fdoc__compose restart "${f1[@]}"
                    ;;
                toggle-start-stop)
                    for i in "${!f1[@]}"; do
                        case ${f3[i]} in
                            running|paused|restarting)
                                _fdoc__compose stop "${f1[i]}"
                                ;;
                            *)
                                _fdoc__compose start "${f1[i]}"
                                ;;
                        esac
                    done
                    ;;
                pause)
                    _fdoc__compose pause "${f1[@]}"
                    ;;
                unpause)
                    _fdoc__compose unpause "${f1[@]}"
                    ;;
                top)
                    for i in "${!f1[@]}"; do
                        printf '\n===== %s =====\n' "${f1[i]}"
                        _fdoc__compose top "${f1[i]}"
                    done
                    _fdoc__pause
                    ;;
                ports)
                    ((${#f1[@]} == 1)) || {
                        printf 'fdoc: port lookup requires exactly one selected service.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    local port
                    printf 'Container port (example: 80): ' > /dev/tty
                    IFS= read -r port </dev/tty || return 1
                    [[ -n $port ]] || return 0
                    _fdoc__compose port "${f1[0]}" "$port"
                    _fdoc__pause
                    ;;
                copy-name)
                    printf '%s\n' "${f1[@]}" | _fdoc__clip
                    ;;
                copy-container)
                    printf '%s\n' "${f2[@]}" | _fdoc__clip
                    ;;
                scale)
                    ((${#f1[@]} == 1)) || {
                        printf 'fdoc: scale requires exactly one selected service.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    local replicas
                    printf 'Desired replicas: ' > /dev/tty
                    IFS= read -r replicas </dev/tty || return 1
                    _fdoc__is_uint "$replicas" || {
                        printf 'fdoc: replicas must be a non-negative integer.\n' >&2
                        _fdoc__pause
                        return 1
                    }
                    _fdoc__compose up -d --scale "${f1[0]}=$replicas" "${f1[0]}"
                    ;;
                pull)
                    _fdoc__compose pull "${f1[@]}"
                    ;;
                build)
                    _fdoc__compose build "${f1[@]}"
                    ;;
            esac
            ;;
    esac
}

