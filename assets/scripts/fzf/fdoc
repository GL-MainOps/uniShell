_fdoc__resource_types_list() {
    cat <<'EOF'
containers	container	Docker Engine	Container
images	image	Docker Engine	Image
volumes	volume	Docker Engine	Volume
networks	network	Docker Engine	Network
compose	compose	Docker Compose (current project)	Service
ctx	context	Docker CLI	Context
EOF
}

_fdoc__resource_types() {
    local selected resource initial_query=${1:-}

    selected=$(
        _fdoc__resource_types_list |
            fzf \
                --with-shell='bash -c' \
                --exact \
                --no-multi \
                --delimiter=$'\t' \
                --with-nth=4 \
                --accept-nth='{1}' \
                --prompt='Docker resource ❯❯❯ ' \
                --query="$initial_query" \
                --header='Enter browse · Ctrl-R reload · Ctrl-/ preview · exact matching' \
                --preview-window='right:55%:hidden:wrap' \
                --preview='printf "Type: %s\\nBackend: %s\\nKind: %s\\n" {1} {3} {4}' \
                --bind='ctrl-r:reload(_fdoc__resource_types_list)' \
                --bind='alt-c:execute-silent(printf %s {1} | _fdoc__clip)'
    ) || return 0

    resource=$selected
    [[ -n $resource ]] || return 0

    if [[ $resource == compose ]]; then
        _fdoc__require_compose || return
    elif [[ $resource == ctx ]]; then
        _fdoc__contexts
        return $?
    fi

    _fdoc__resource_picker "$resource"
}

# -----------------------------------------------------------------------------
# Docker context picker
# -----------------------------------------------------------------------------

_fdoc__context_header() {
    printf '%s\n%s' \
        'Enter use context · Ctrl-R reload · Ctrl-D delete · Alt-C copy' \
        'Docker context changes the persistent Docker CLI default · Ctrl-/ preview'
}

_fdoc__contexts() {
    local selected
    local initial_query=${*:-}

    selected=$(
        _fdoc__contexts_list |
            fzf \
                --with-shell='bash -c' \
                --exact \
                --no-multi \
                --delimiter=$'\t' \
                --with-nth=6 \
                --accept-nth='{1}' \
                --prompt='Docker context ❯❯❯ ' \
                --query="$initial_query" \
                --header="$(_fdoc__context_header)" \
                --preview='_fdoc__preview_context {1}' \
                --preview-window='right:55%:hidden:wrap' \
                --bind='ctrl-r:reload(_fdoc__contexts_list)' \
                --bind='ctrl-d:execute(_fdoc__context_delete {1})+reload(_fdoc__contexts_list)' \
                --bind='alt-c:execute-silent(printf %s {1} | _fdoc__clip)'
    ) || return 0

    [[ -n $selected ]] || return 0

    # fzf ran in a child process, so perform the actual parent-shell operation
    # here. This intentionally changes Docker's persistent default context,
    # matching `docker context use` semantics.
    _fdoc__docker context use "$selected"
}

_fdoc__context_delete() {
    local context=$1
    [[ -n $context ]] || return 0

    printf 'Context: %s\n' "$context"
    _fdoc__confirm 'Delete this Docker context?' || return 0
    _fdoc__docker context rm "$context"
}

