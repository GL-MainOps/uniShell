" Function to toggle comments for selected lines
function! ToggleCommentLines()
    let ft = &filetype
    let s:line_comments = {
        \ 'c': '//', 'cpp': '//', 'java': '//', 'javascript': '//',
        \ 'typescript': '//', 'go': '//', 'rust': '//', 'php': '//',
        \ 'css': '//', 'swift': '//', 'kotlin': '//', 'scala': '//',
        \ }
    let cs = has_key(s:line_comments, ft) ? s:line_comments[ft] . ' '
        \ : (empty(&commentstring) ? '# ' : trim(split(&commentstring, '%s', 1)[0]) . ' ')
    let first_line = getline("'<")
    if first_line =~ '^\s*' . escape(trim(cs), '/\.*[]')
        execute "'<,'>s/^\\(\\s*\\)" . escape(trim(cs), '/\') . "\\s*/\\1/"
    else
        execute "'<,'>s/^/" . escape(cs, '/\') . "/"
    endif
endfunction


" Diff current buffer against saved file on disk
function! DiffWithSaved()
    let filetype = &filetype
    diffthis
    vnew | r # | normal! 1Gdd
    diffthis
    execute 'setlocal bt=nofile bh=wipe nobl noswf ro ft=' . filetype
endfunction
nnoremap <leader>ds :call DiffWithSaved()<CR>


