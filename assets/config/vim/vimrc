"==================================================
" FILETYPE-SPECIFIC SETTINGS
"==================================================
" Allow saving of files as sudo when I forgot to start vim using sudo
" cnoremap w!! w !sudo -E tee > /dev/null %
function! SudoWrite()
    if !filereadable(expand('%'))
        echo 'New file, no sudo needed'
        return
    endif
    write !sudo -E tee > /dev/null %
    edit!
endfunction
nnoremap <silent> <leader>WW :call SudoWrite()<CR>


" Detect and warn on mixed indentation
function! CheckMixedIndent()
    let has_tabs    = search('^\t', 'nw')
    let has_spaces  = search('^ ', 'nw')
    if has_tabs && has_spaces
        echohl WarningMsg
        echo 'Warning: mixed tabs and spaces in ' . expand('%:t')
        echohl None
    endif
endfunction
augroup mixed_indent
    autocmd!
    autocmd BufReadPost *.py,*.yaml,*.yml call CheckMixedIndent()
augroup END



