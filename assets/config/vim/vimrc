let $VIM_CACHE_HOME = $VIM_CACHE_HOME

for dir in ['swap', 'undo', 'backup']
    let fullpath = expand($VIM_CACHE_HOME . '/' . dir)
    if !isdirectory(fullpath)
        call mkdir(fullpath, 'p')
    endif
endfor

let &directory = expand($VIM_CACHE_HOME . '/swap//')
let &undodir   = expand($VIM_CACHE_HOME . '/undo//')
let &backupdir = expand($VIM_CACHE_HOME . '/backup//')

" Enable persistence features
set undofile
set backup
set swapfile

let &viminfo = "'1000,n" . $VIM_CACHE_HOME . "/viminfo"


"==================================================
" CORE EDITOR SETTINGS
"==================================================

" Interface & Behavior
set novisualbell         " Disable visual bell
set nospell              " Disable spellcheck
set mouse-=a             " Disable mouse in all modes
set wrap                 " Wrap long lines
set history=1000         " Increase command history (default:20)
set laststatus=2         " Always show status line
" set title                " Show window title
set clipboard=unnamed    " Use system clipboard
set wildmenu             " Enhanced command completion
set report=0             " Always report changed lines
set lazyredraw           " Optimize macro execution
set ttyfast              " Faster redraw for modern terminals
set autoread             " Reload files changed externally
set showmatch            " Highlight matching brackets
set scrolloff=6          " Minimum context lines around cursor
set nojoinspaces         " Single space after '.'
set updatetime=500       " Shorter delay for events
set encoding=utf-8       " Default encoding
set background=dark      " Colorscheme background hint
" set omnifunc=syntaxcomplete#Complete  " Omnicompletion backend

"set statusline=%F        " Show full path of the opened file
set statusline=%F\ %m%r%=%l/%L\ %p%%\ [%{&ff}/%Y]

" Folding
set foldlevel=99         " start with all folds open
set foldenable           " ensure folding is enabled

" Display
set nonumber             " Disable line numbers
set linebreak            " Wrap at word boundaries
set breakindent          " Indent wrapped lines


" Indentation & Tabs
set tabstop=4            " Spaces per tab
set shiftwidth=0         " Use tabstop value for indentation
set softtabstop=-1       " Use tabstop value
set expandtab            " Convert tabs to spaces
set smarttab             " Better tab behavior
set smartindent          " Context-aware indentation
set autoindent           " Maintain current indent level

" Search Settings
set ignorecase           " Case-insensitive search
set smartcase            " Case-sensitive if uppercase present
set magic                " Use regex 'magic' mode
set incsearch            " Show matches while typing
"set hlsearch            " Keep matches highlighted

" Window Management
set splitbelow           " New horizontal splits go below
set splitright           " New vertical splits go right


"==================================================
" SYNTAX & FILETYPE HANDLING
"==================================================

syntax on                " Enable syntax highlighting
filetype detect          " Detect file types
filetype plugin on       " Load filetype plugins
filetype indent on       " Load indent rules


